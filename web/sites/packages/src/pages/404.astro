---
// A real 404 page. Without one, Cloudflare Pages serves the home page with a 200 for any path
// that doesn't exist, so a mistyped package name looks like the registry index.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Wheels packages" description="This page doesn't exist.">
  <section class="not-found">
    <h1>Page not found</h1>
    <p>There's no package or page at this address. Check the name, or browse the registry.</p>
    <ul>
      <li><a href="/">All packages</a></li>
      <li><a href="https://guides.wheels.dev/">Guides</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: 40rem;
    margin: 4rem auto;
    padding: 0 1rem;
  }
</style>
