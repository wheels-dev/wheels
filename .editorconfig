root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
indent_size = 2
trim_trailing_whitespace = true

[*.yml]
indent_style = space

[*.sh]
indent_style = space

[{index.cfm,rewrite.cfm,root.cfm,wheels/index.cfm}]
insert_final_newline = false

# Per-request/lifecycle event templates emit zero output: they are $include'd into
# the response buffer, so a trailing newline after </cfsilent> leaks as whitespace
# before renderText output and breaks XML. Keep them newline-free (demo app/events
# and the CLI generator templates). See #3882.
[**/events/{onabort,onapplicationend,onapplicationstart,onrequestend,onrequeststart,onsessionend,onsessionstart}.cfm]
insert_final_newline = false
