# .kamal/secrets — resolved at deploy time by wheels deploy.
#
# Keep secret VALUES out of this file. Each line should look a value up at
# deploy time, either from your secret manager with $(cmd), e.g. 1Password:
#   KAMAL_REGISTRY_PASSWORD=$(op read op://Deploy/Registry/password)
#   WHEELS_RELOAD_PASSWORD=$(op read op://Deploy/{{service_name}}/reload-password)
# or from an environment variable set by your shell or CI, with ${VAR}:
#   KAMAL_REGISTRY_PASSWORD=${KAMAL_REGISTRY_PASSWORD}
#
# wheels deploy init creates this file owner-only (0600) and lists it in
# .gitignore. Never commit it.
KAMAL_REGISTRY_PASSWORD=
WHEELS_RELOAD_PASSWORD=
